        {
          "key": "overheat_enabled",
          "label": "Перегрев",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "key": "condition_state",
      "toggle_label": "🌒 Условные / проклятые / повреждённые состояния",
      "default_on": false,
      "fields": [
        {
          "key": "cursed",
          "label": "Проклято",
          "type": "bool",
          "default": false
