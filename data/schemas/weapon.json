        {
          "key": "corrupted",
          "label": "Осквернено",
          "type": "bool",
          "default": false
        },
        {
          "key": "day_night_restriction",
          "label": "Ограничение день/ночь",
          "type": "enum",
          "options": [
            "none",
            "day_only",
            "night_only"
          ]
