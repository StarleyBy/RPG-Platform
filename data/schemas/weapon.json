{
  "id": "weapon",
  "group": "equipment",
  "label": "Оружие",
  "icon": "⚔️",
  "color": "#3d6bb3",
  "description": "Любое оружие ближнего/дальнего боя, посохи, огнестрел, футуристичное оружие.",
  "save_path": "res://game_data/items/weapon/%s.json",
  "base_fields": [
    {
      "key": "id",
      "label": "ID предмета",
      "type": "id",
      "default": "weapon_new_01"
    },
    {
      "key": "name",
      "label": "Название",
      "type": "string",
      "default": ""
    },
    {
      "key": "subtype",
      "label": "Подтип",
      "type": "enum",
      "default_index": 0,
      "options_ref": "weapon_subtypes"
    },
    {
      "key": "rarity",
      "label": "Редкость",
      "type": "enum",
      "options_ref": "rarity_tiers",
      "default_index": 5
    },
    {
      "key": "quality",
      "label": "Качество",
      "type": "enum",
      "options_ref": "quality_tiers",
      "default_index": 3
    },
    {
      "key": "equipment_slot",
      "label": "Слот",
      "type": "enum",
      "options": [
        "main_hand",
        "off_hand",
        "both_hands",
        "ranged_slot",
        "none"
      ]
    },
    {
      "key": "material",
      "label": "Материал",
      "type": "string",
      "default": ""
    },
    {
      "key": "value",
      "label": "Цена (золото)",
      "type": "float",
      "default": 100,
      "min": 0
    },
    {
      "key": "weight",
      "label": "Вес",
      "type": "float",
      "default": 2.0,
      "min": 0
    },
    {
      "key": "durability_max",
      "label": "Прочность",
      "type": "int",
      "default": 100,
      "min": 0
    },
    {
      "key": "item_power",
      "label": "Item Power / iLvl",
      "type": "int",
      "default": 1,
      "min": 0
    },
    {
      "key": "set_id",
      "label": "ID сета (если есть)",
      "type": "reference",
      "default": ""
    },
    {
      "key": "tags",
      "label": "Теги",
      "type": "tags",
      "default": [
        "weapon"
      ]
    }
