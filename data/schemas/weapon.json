    {
      "key": "affixes",
      "toggle_label": "📜 Аффиксы / динамические формулы усиления",
      "default_on": false,
      "note": "Пример: 'Усиливает физический урон на 15% + 0.1% за уровень героя'.",
      "fields": [
        {
          "key": "affixes",
          "label": "Аффиксы",
          "type": "ability_list"
        },
        {
          "key": "custom_formula",
          "label": "Доп. формула (опционально)",
          "type": "formula"
        }
      ]
