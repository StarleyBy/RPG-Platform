        {
          "key": "soulbound",
          "label": "Привязка к душе (Soulbound)",
          "type": "bool",
          "default": false
        },
        {
          "key": "required_level",
          "label": "Требуемый уровень",
          "type": "int",
          "default": 1
        }
      ]
