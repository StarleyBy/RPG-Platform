    {"key": "name", "label": "Название фазы", "type": "string", "default": ""},
    {"key": "phase_order", "label": "Порядковый номер", "type": "int", "default": 1},
    {"key": "world_id", "label": "Мир (ID)", "type": "reference", "default": ""}
