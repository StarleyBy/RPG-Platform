  "sections": [
    {
      "key": "trigger",
      "toggle_label": "🎬 Триггер перехода",
      "default_on": true,
      "fields": [
        {"key": "trigger_type", "label": "Тип триггера", "type": "enum",
          "options": ["quest_completion", "time_elapsed", "player_choice", "scripted_event"]},
        {"key": "trigger_condition", "label": "Условие", "type": "string", "default": ""}
      ]
    },
    {
      "key": "changes",
      "toggle_label": "🔄 Изменения мира",
