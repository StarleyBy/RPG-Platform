      "note": "Каждая строка: verb=sets_state, target=ID_локации, value=новое_состояние.",
      "fields": [{"key": "location_state_changes", "label": "Изменения состояний локаций", "type": "ability_list"}]
    },
    {
      "key": "lore",
      "toggle_label": "📖 Описание фазы",
      "default_on": false,
      "fields": [{"key": "lore_text", "label": "Текст", "type": "text", "default": ""}]
